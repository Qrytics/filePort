[
  {
    "id": "files_collection",
    "name": "files",
    "type": "base",
    "system": false,
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": "@request.auth.id != ''",
    "fields": [
      {
        "name": "path",
        "type": "text",
        "required": true,
        "options": { "max": 4096 }
      },
      {
        "name": "name",
        "type": "text",
        "required": true,
        "options": { "max": 255 }
      },
      {
        "name": "content",
        "type": "text",
        "required": false,
        "options": { "max": 10485760 }
      },
      {
        "name": "is_directory",
        "type": "bool",
        "required": false
      },
      {
        "name": "last_modified_local",
        "type": "date",
        "required": false
      },
      {
        "name": "last_modified_mobile",
        "type": "date",
        "required": false
      },
      {
        "name": "needs_sync",
        "type": "bool",
        "required": false
      },
      {
        "name": "file_size",
        "type": "number",
        "required": false,
        "options": { "min": 0 }
      },
      {
        "name": "mime_type",
        "type": "text",
        "required": false,
        "options": { "max": 255 }
      }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX idx_files_path ON files (path)",
      "CREATE INDEX idx_files_needs_sync ON files (needs_sync)"
    ]
  }
]
